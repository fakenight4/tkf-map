{
  "name": "tkf",
  "version": "0.1.0",
  "private": true,
  "description": "塔科夫交互地图 / 小地图 / 截图定位",
  "author": "TKF",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win dir"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "local.tkf.map",
    "productName": "TKF地图",
    "copyright": "Copyright © TKF",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "executableName": "TKF地图",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TKF地图",
      "artifactName": "${productName}-安装包-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-便携版-${version}.${ext}"
    }
  }
}
